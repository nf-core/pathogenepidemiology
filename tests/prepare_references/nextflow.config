// Use locally installed wget, gzip, samtools and gatk; no containers or downloads
// other than the tiny fixtures served on localhost by the Python tests.
includeConfig '../../conf/modules.config'
params.publish_dir_mode = 'copy'
process.executor = 'local'
process.cpus = 1
process.memory = '256.MB'
process.ext.args = ''
docker.enabled = false
conda.enabled = false
singularity.enabled = false
