#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == --version ]]; then
    echo 'bcftools 0.0.0'
    exit
fi
[[ "$1" == concat ]] || exit 20
shift
[[ "$1" == --output ]] || exit 21
output=$2
shift 2
[[ "$1" == -Ob && "$2" == --write-index && "$3" == --threads ]] || exit 22
shift 4
# Preserve and expose the actual production concat command's argument order.
: > "$output"
for vcf in "$@"; do
    [[ -f "$vcf.tbi" ]] || exit 23
    printf '%s\t%s\n' "$vcf" "$(head -n 1 "$vcf" | cut -f 1)" >> "$output"
done
touch "$output.csi"
