process {
    withName: BCFTOOLS_CONCAT {
        memory = 2.GB
        cpus = 1
        // Record workflow inputs before the vendored module's filename sort.
        beforeScript = {
            """
            printf '%s\\n' ${vcfs.collect { vcf -> "'${vcf.name}'" }.join(' ')} > concat-vcfs.txt
            printf '%s\\n' ${tbi.collect { index -> "'${index.name}'" }.join(' ')} > concat-indexes.txt
            """
        }
    }
}
