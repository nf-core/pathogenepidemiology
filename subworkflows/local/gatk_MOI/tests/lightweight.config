includeConfig '../../prepare_intervals/tests/nextflow.config'

process.beforeScript = "export PATH='${projectDir}/subworkflows/local/gatk_MOI/tests/bin':\$PATH"

process {
    withName: 'GATK4_GENOTYPEGVCFS' {
        // Synthetic bytes only: exercise the size gate without real analysis.
        afterScript = { params.force_recalibration_stub ? "head -c 9001 /dev/zero >> ${meta.id}.vcf.gz" : 'true' }
    }
    withName: 'GATK4_HAPLOTYPECALLER|GATK4_GENOMICSDBIMPORT' {
        afterScript = {
            def contig = meta.chr ?: meta.id
            def expected = contig == 'alpha' ? 'alpha\\t0\\t1\\nalpha\\t2\\t3' : 'zeta\\t0\\t1'
            def check = task.process.endsWith('GATK4_GENOMICSDBIMPORT') ? 'set -- *.vcf.gz; test "$#" -eq 2' : '''
                test "$(cat query.fa)" = "$(printf '>zeta\\nA\\n>alpha\\nA')"
                test "$(cat query.fa.fai)" = "$(printf 'zeta\\t1\\t6\\t1\\t2\\nalpha\\t1\\t15\\t1\\t2')"
                test -f query.dict
            '''
            """
            test "\$(cat ${contig}.bed)" = "\$(printf '%b' '${expected}')"
            ${check}
            """
        }
    }
    withName: 'GATK4_VARRECAL_.*' {
        afterScript = '''
        test -s query.fa
        test -s query.fa.fai
        test -f query.dict
        test -s alpha.bed
        test -s zeta.bed
        '''
    }
}
