nextflow_workflow {
    name "Test Subworkflow GATK_MOI"
    script "../main.nf"
    config "./nextflow.config"
    workflow "GATK_MOI"
    options "-stub"

    test("GATK_MOI concatenates small stub VCFs from a two-sample cohort without VQSR") {
        when {
            workflow {
                """
                input[0] = Channel.of(
                    tuple(
                        [id: 'test'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    ),
                    tuple(
                        [id: 'test2'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    )
                )
                input[1] = Channel.of(
                    tuple(
                        [id: 'test_ref'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true)
                    )
                )
                input[2] = Channel.of(
                    tuple(
                        [id: 'test_ref'],
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true)
                    )
                )
                input[3] = Channel.of(
                    file("${projectDir}/assets/Strains.2kb.vcf.gz", checkIfExists: true)
                )
                input[4] = Channel.of(
                    file("${projectDir}/assets/Strains.2kb.vcf.gz.tbi", checkIfExists: true)
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Small stub VCFs bypass VQSR, but still produce a cohort.
                { assert workflow.out.varcalls_s.size() == 1 },
                { assert workflow.out.varcalls_s[0][0] == [id: 'cohort'] },
                { assert workflow.out.varcalls_s[0][1].endsWith('cohort.bcf.gz') },
                { assert workflow.out.varcalls_s[0][2].endsWith('cohort.bcf.gz.csi') },
                {
                    [workflow.out.insert_size_metrics, workflow.out.mosdepth_summary, workflow.out.mosdepth_global].each { channel ->
                        assert channel.size() == 2
                        assert channel.collect { it[0] }.toSet() == [[id: 'test'], [id: 'test2']].toSet()
                        channel.each { entry ->
                            assert entry.size() == 2
                            assert entry[1] instanceof String
                        }
                    }
                }
            )
        }
    }

}
