// Focused runner: includes canonical module tests ignored by the pipeline runner.
// Invoke from the repository root (see README.md).
config {
    testsDir = '.'
    workDir = System.getenv('NFT_WORKDIR') ?: '.nf-test'
    configFile = 'tests/nextflow.config'
    profile = 'test,docker'
    plugins {
        // WGET's upstream sanitizeOutput assertions require this version.
        load 'nft-utils@0.0.9'
    }
}
