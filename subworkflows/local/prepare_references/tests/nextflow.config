includeConfig '../../prepare_intervals/tests/nextflow.config'

// No downloads or analysis. Local download/gunzip modules have no stub blocks.
process.beforeScript = """
export PATH='${projectDir}/subworkflows/local/prepare_intervals/tests/bin':\$PATH
wget() { printf '>synthetic\\nA\\n' > "\$2"; }
gunzip() { cat "\$2"; }
samtools() { test "\$1" = version; echo 'samtools 0.0.0'; }
export -f wget gunzip samtools
"""

process {
    withName: 'SAMTOOLS_FAIDX' { ext.args = '' }
}
