process.executor = 'local'
process.cpus = 1
process.memory = '256.MB'
docker.enabled = false
conda.enabled = false
singularity.enabled = false
process.beforeScript = "export PATH='${projectDir}/subworkflows/local/prepare_intervals/tests/bin':\$PATH"
process {
    withName: 'GATK4_SPLITINTERVALS' {
        afterScript = { params.fake_duplicate_contig ? 'cp intervals/0000-scattered.interval_list intervals/9999-scattered.interval_list' : 'true' }
    }
    withLabel: 'process_.*' {
        cpus = 1
        memory = '256.MB'
        time = '10.m'
    }
}
