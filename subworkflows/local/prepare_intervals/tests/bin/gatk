#!/usr/bin/env bash
set -euo pipefail
if [[ "$*" == *--version* ]]; then
    echo 'The Genome Analysis Toolkit (GATK) v0.0.0'
    exit 0
fi
# Wiring-only synthetic conversion. This is not a GATK correctness test.
tool=''; input=''; output=''; reference=''; mix=''; scatter=''
while (($#)); do
    case "$1" in
        SplitIntervals|IntervalListToBed) tool=$1; shift ;;
        --java-options|--tmp-dir|--TMP_DIR|--interval-merging-rule|--subdivision-mode) shift 2 ;;
        --intervals|--INPUT) input=$2; shift 2 ;;
        --output|--OUTPUT) output=$2; shift 2 ;;
        --reference) reference=$2; shift 2 ;;
        --dont-mix-contigs) mix=$2; shift 2 ;;
        --scatter-count) scatter=$2; shift 2 ;;
        *) echo "Unexpected fake GATK argument: $1" >&2; exit 30 ;;
    esac
done
case "$tool" in
    SplitIntervals)
        [[ "$mix" == true && "$scatter" == 1 && -f "$reference" && -f "$reference.fai" ]]
        [[ -f "${reference%.*}.dict" ]]
        mkdir "$output"
        awk -v out="$output" 'BEGIN { FS=OFS="\t" }
            /^#/ || /^track/ || /^browser/ || NF == 0 { next }
            !($1 in ids) { ids[$1]=++n }
            { f=sprintf("%s/%04d-scattered.interval_list",out,ids[$1]-1);
              print $1,$2+1,$3,"+","synthetic" >> f }' "$input"
        ;;
    IntervalListToBed)
        awk 'BEGIN { FS=OFS="\t" } !/^@/ {print $1,$2-1,$3}' "$input" > "$output"
        ;;
    *) exit 30 ;;
esac
