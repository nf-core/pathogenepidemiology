nextflow_workflow {
    name 'PREPARE_INTERVALS wiring (fake GATK, no analysis)'
    script '../main.nf'
    workflow 'PREPARE_INTERVALS'
    config './nextflow.config'

    test('default tracked core BED produces one chromosome id per output') {
        when {
            workflow {
                """
                def fasta = file('${outputDir}/Pf3D7.fa'); fasta.text = '>synthetic\\nA\\n'
                def fai = file('${outputDir}/Pf3D7.fa.fai'); fai.text = 'synthetic\\t1\\t0\\t1\\t2\\n'
                input[0] = null
                input[1] = Channel.value(tuple([id: 'query'], fasta))
                input[2] = Channel.value(tuple([id: 'query'], fai))
                input[3] = Channel.value(tuple([id: 'query'], file('${projectDir}/assets/Pf3D7.dict')))
                """
            }
        }
        then {
            assert workflow.success
            def expected = file("${projectDir}/assets/Pf3D7_core.bed")
            assert file(workflow.out.core_bed[0]).toString() == expected.toString()
            assert workflow.out.intervals.collectMany { file(it[1]).readLines() }.sort() == expected.readLines().sort()
            assert workflow.out.intervals.collect { it[0].id }.sort() == expected.readLines().collect { it.split('\t')[0] }.unique().sort()
            assert workflow.out.intervals.every { meta, bed ->
                meta == [id: file(bed).readLines().first().split('\t')[0]] && file(bed).name == "${meta.id}.bed"
            }
        }
    }

    test('custom interleaved core regions still produce one file per contig') {
        when {
            workflow {
                """
                def bed = file('${outputDir}/custom.bed')
                bed.text = file('${projectDir}/assets/Pf3D7_core.bed').readLines().sort { it.split('\\t')[1].toInteger() }.join('\\n') + '\\n'
                def fasta = file('${outputDir}/Pf3D7.fa'); fasta.text = '>synthetic\\nA\\n'
                def fai = file('${outputDir}/Pf3D7.fa.fai'); fai.text = 'synthetic\\t1\\t0\\t1\\t2\\n'
                input[0] = bed.toString()
                input[1] = Channel.value(tuple([id: 'query'], fasta))
                input[2] = Channel.value(tuple([id: 'query'], fai))
                input[3] = Channel.value(tuple([id: 'query'], file('${projectDir}/assets/Pf3D7.dict')))
                """
            }
        }
        then {
            assert workflow.success
            def expected = file("${outputDir}/custom.bed")
            assert file(workflow.out.core_bed[0]).toString() == expected.toString()
            assert workflow.out.intervals.collectMany { file(it[1]).readLines() }.sort() == expected.readLines().sort()
            assert workflow.out.intervals.collect { it[0].id }.sort() == expected.readLines().collect { it.split('\t')[0] }.unique().sort()
            assert workflow.out.intervals.every { meta, bed -> file(bed).readLines().every { it.split('\t')[0] == meta.id } }
        }
    }

    test('single-contig subset normalizes single-path output') {
        when {
            workflow {
                """
                def bed = file('${outputDir}/single.bed')
                bed.text = file('${projectDir}/assets/Pf3D7_core.bed').readLines().take(3).join('\\n') + '\\n'
                def fasta = file('${outputDir}/Pf3D7.fa'); fasta.text = '>synthetic\\nA\\n'
                def fai = file('${outputDir}/Pf3D7.fa.fai'); fai.text = 'synthetic\\t1\\t0\\t1\\t2\\n'
                input[0] = bed.toString()
                input[1] = Channel.value(tuple([id: 'query'], fasta))
                input[2] = Channel.value(tuple([id: 'query'], fai))
                input[3] = Channel.value(tuple([id: 'query'], file('${projectDir}/assets/Pf3D7.dict')))
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.intervals.size() == 1
            assert workflow.out.intervals[0][0] == [id: 'Pf3D7_01_v3']
            assert file(workflow.out.intervals[0][1]).text == file("${outputDir}/single.bed").text
        }
    }

    test('duplicate contig files fail before conversion') {
        when {
            params { fake_duplicate_contig = true }
            workflow {
                """
                def fasta = file('${outputDir}/Pf3D7.fa'); fasta.text = '>synthetic\\nA\\n'
                def fai = file('${outputDir}/Pf3D7.fa.fai'); fai.text = 'synthetic\\t1\\t0\\t1\\t2\\n'
                input[0] = null
                input[1] = Channel.value(tuple([id: 'query'], fasta))
                input[2] = Channel.value(tuple([id: 'query'], fai))
                input[3] = Channel.value(tuple([id: 'query'], file('${projectDir}/assets/Pf3D7.dict')))
                """
            }
        }
        then {
            assert !workflow.success
            assert workflow.errorReport.contains("duplicate contig 'Pf3D7_01_v3'")
            assert workflow.errorReport.contains('9999-scattered.interval_list')
            assert !workflow.trace.tasks().any { it.name.contains('INTERVALLISTTOBED') }
        }
    }

    test('unsupported contig fails before conversion') {
        when {
            workflow {
                """
                def bed = file('${outputDir}/unsafe.bed'); bed.text = 'chr;unsafe\\t0\\t1\\n'
                def fasta = file('${outputDir}/Pf3D7.fa'); fasta.text = '>synthetic\\nA\\n'
                def fai = file('${outputDir}/Pf3D7.fa.fai'); fai.text = 'synthetic\\t1\\t0\\t1\\t2\\n'
                input[0] = bed.toString()
                input[1] = Channel.value(tuple([id: 'query'], fasta))
                input[2] = Channel.value(tuple([id: 'query'], fai))
                input[3] = Channel.value(tuple([id: 'query'], file('${projectDir}/assets/Pf3D7.dict')))
                """
            }
        }
        then {
            assert !workflow.success
            assert workflow.errorReport.contains("Unsupported contig 'chr;unsafe' for output filenames")
            assert !workflow.trace.tasks().any { it.name.contains('INTERVALLISTTOBED') }
        }
    }

    test('empty interval lists retain per-file validation') {
        options '-stub'
        when {
            workflow {
                """
                def fasta = file('${outputDir}/Pf3D7.fa'); fasta.text = '>synthetic\\nA\\n'
                def fai = file('${outputDir}/Pf3D7.fa.fai'); fai.text = 'synthetic\\t1\\t0\\t1\\t2\\n'
                input[0] = null
                input[1] = Channel.value(tuple([id: 'query'], fasta))
                input[2] = Channel.value(tuple([id: 'query'], fai))
                input[3] = Channel.value(tuple([id: 'query'], file('${projectDir}/assets/Pf3D7.dict')))
                """
            }
        }
        then {
            assert !workflow.success
            assert workflow.errorReport.contains('Expected one contig')
            assert workflow.errorReport.contains('found []')
        }
    }

    test('non-local BED is rejected') {
        when {
            workflow {
                """
                input[0] = 'https://example.invalid/core.bed'
                input[1] = Channel.empty()
                input[2] = Channel.empty()
                input[3] = Channel.empty()
                """
            }
        }
        then {
            assert !workflow.success
            assert workflow.stdout.any { it.contains('--intervals must be a single local uncompressed BED') }
        }
    }
}
