nextflow_workflow {
    name 'PREPARE_INTERVALS with the local Pf3D7 reference'
    script '../main.nf'
    workflow 'PREPARE_INTERVALS'

    test('default tracked core BED produces one chromosome id per output') {
        when {
            workflow {
                """
                def reference = '${projectDir}/assets/Plasmodium_falciparum.GCA000002765v3.dna.toplevel'
                input[0] = null
                input[1] = Channel.value(tuple([id: 'query'], file(reference + '.fa')))
                input[2] = Channel.value(tuple([id: 'query'], file(reference + '.fa.fai')))
                input[3] = Channel.value(tuple([id: 'query'], file(reference + '.dict')))
                """
            }
        }
        then {
            assert workflow.success
            def expected = file("${projectDir}/assets/Pf3D7_core.bed")
            assert file(workflow.out.core_bed[0]).toString() == expected.toString()
            def rows = workflow.out.intervals.collectMany { file(it[1]).readLines() }
            assert rows.collect { it.split('\t').take(3).join('\t') }.sort() == expected.readLines().sort()
            assert workflow.out.intervals.collect { it[0].id }.sort() == expected.readLines().collect { it.split('\t')[0] }.unique().sort()
            assert workflow.out.intervals.every { meta, bed ->
                meta == [id: file(bed).readLines().first().split('\t')[0]] && file(bed).name == "${meta.id}.bed"
            }
        }
    }

    test('custom interleaved intervals preserve coordinates and one file per contig') {
        when {
            workflow {
                """
                def fixtures = '${outputDir}'
                def reference = '${projectDir}/assets/Plasmodium_falciparum.GCA000002765v3.dna.toplevel'
                file(fixtures + '/interleaved.bed').text = 'Pf3D7_02_v3\\t0\\t1\\nPf3D7_01_v3\\t4\\t8\\nPf3D7_02_v3\\t2\\t3\\nPf3D7_01_v3\\t10\\t12\\n'
                input[0] = fixtures + '/interleaved.bed'
                input[1] = Channel.value(tuple([id: 'query'], file(reference + '.fa')))
                input[2] = Channel.value(tuple([id: 'query'], file(reference + '.fa.fai')))
                input[3] = Channel.value(tuple([id: 'query'], file(reference + '.dict')))
                """
            }
        }
        then {
            assert workflow.success
            def expected = file("${outputDir}/interleaved.bed")
            assert file(workflow.out.core_bed[0]).toString() == expected.toString()
            assert workflow.out.intervals.collectMany { file(it[1]).readLines() }.collect {
                it.split('\t').take(3).join('\t')
            }.sort() == expected.readLines().sort()
            assert workflow.out.intervals.collect { it[0].id }.sort() == ['Pf3D7_01_v3', 'Pf3D7_02_v3']
            assert workflow.out.intervals.every { meta, bed ->
                file(bed).name == "${meta.id}.bed" && file(bed).readLines().every { it.split('\t')[0] == meta.id }
            }
        }
    }

    test('single-contig subset normalizes single-path output') {
        when {
            workflow {
                """
                def fixtures = '${outputDir}'
                def reference = '${projectDir}/assets/Plasmodium_falciparum.GCA000002765v3.dna.toplevel'
                file(fixtures + '/single.bed').text = 'Pf3D7_01_v3\\t0\\t1\\nPf3D7_01_v3\\t2\\t3\\n'
                input[0] = fixtures + '/single.bed'
                input[1] = Channel.value(tuple([id: 'query'], file(reference + '.fa')))
                input[2] = Channel.value(tuple([id: 'query'], file(reference + '.fa.fai')))
                input[3] = Channel.value(tuple([id: 'query'], file(reference + '.dict')))
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.intervals.size() == 1
            assert workflow.out.intervals[0][0] == [id: 'Pf3D7_01_v3']
            assert file(workflow.out.intervals[0][1]).readLines().collect {
                it.split('\t').take(3).join('\t')
            } == file("${outputDir}/single.bed").readLines()
        }
    }

    test('unsafe BED basename is rejected before GATK') {
        when {
            workflow {
                """
                file('${outputDir}/unsafe;name.bed').text = 'Pf3D7_01_v3\\t0\\t1\\n'
                input[0] = '${outputDir}/unsafe;name.bed'
                input[1] = Channel.empty()
                input[2] = Channel.empty()
                input[3] = Channel.empty()
                """
            }
        }
        then {
            assert !workflow.success
            def errorReport = workflow.errorReport ?: (workflow.stdout + workflow.stderr).join('\n')
            assert errorReport.contains('--intervals BED basename must contain only')
        }
    }

    test('missing local BED is rejected') {
        when {
            workflow {
                """
                input[0] = '${outputDir}/missing.bed'
                input[1] = Channel.empty()
                input[2] = Channel.empty()
                input[3] = Channel.empty()
                """
            }
        }
        then {
            assert !workflow.success
            def errorReport = workflow.errorReport ?: (workflow.stdout + workflow.stderr).join('\n')
            assert errorReport.contains('missing.bed')
            assert errorReport.contains('No such file or directory:')
        }
    }

    test('non-local BED is rejected') {
        when {
            workflow {
                """
                input[0] = 'https://example.invalid/core.bed'
                input[1] = Channel.empty()
                input[2] = Channel.empty()
                input[3] = Channel.empty()
                """
            }
        }
        then {
            assert !workflow.success
            // Early validation can exit before nf-test registers its onComplete report writer.
            def errorReport = workflow.errorReport ?: (workflow.stdout + workflow.stderr).join('\n')
            assert errorReport.contains('--intervals must be a single local uncompressed BED file (.bed).')
        }
    }
}
