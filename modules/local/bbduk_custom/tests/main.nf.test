nextflow_process {

    name "Test reusable Process BBDUK_CUSTOM (trimming configuration)"
    script "../main.nf"
    process "BBDUK_CUSTOM"
    config "./nextflow.config"

    tag "modules"
    tag "bbmap/bbduk"

    test("single-end adapter trimming") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test', single_end: true],
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)]
                ]
                input[1] = file("${projectDir}/assets/adapters.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assert process.out.reads[0][1].endsWith('test.trim_trimmed.fastq.gz')
            assert path(process.out.log[0][1]).text.contains('Input is being processed as unpaired')
            assert process.out.discarded[0][1].endsWith('.trimmed.discarded.fastq.gz')
        }
    }

    test("paired-end adapter trimming") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test', single_end: false],
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                     file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)]
                ]
                input[1] = file("${projectDir}/assets/adapters.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assert process.out.reads[0][1].size() == 2
            assert process.out.discarded[0][1].size() == 2
            assert path(process.out.log[0][1]).text.contains('Input is being processed as paired')
        }
    }

    test("single-end adapter trimming stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [id: 'test', single_end: true],
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)]
                ]
                input[1] = file("${projectDir}/assets/adapters.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assert process.out.reads[0][1].endsWith('test.trim_trimmed.fastq.gz')
            assert process.out.stats[0][1].endsWith('.trimmed.stats.txt')
            assert process.out.log[0][1].endsWith('.trimmed.bbduk.log')
        }
    }

    test("paired-end adapter trimming stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [id: 'test', single_end: false],
                    [file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                     file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)]
                ]
                input[1] = file("${projectDir}/assets/adapters.fa", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assert process.out.reads[0][1].size() == 2
            assert process.out.discarded[0][1].size() == 2
        }
    }
}
