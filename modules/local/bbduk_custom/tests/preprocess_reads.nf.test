nextflow_workflow {

    name "Test BBDUK_CUSTOM reuse in PREPROCESS_READS"
    script "../../../../subworkflows/local/preprocess_reads.nf"
    workflow "PREPROCESS_READS"
    config "./nextflow.config"

    tag "modules"
    tag "bbmap/bbduk"
    tag "subworkflows/preprocess_reads"

    test("single and paired reads - PhiX plus supplied reference") {
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def read1 = file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                def read2 = file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                input[0] = Channel.of(
                    tuple([id: 'single', single_end: true, instrument_platform: 'ILLUMINA'], [read1]),
                    tuple([id: 'paired', single_end: false, instrument_platform: 'ILLUMINA'], [read1, read2])
                )
                input[1] = Channel.value(file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true))
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().size() == 6
            ['BBDUK_TRIM', 'BBDUK_FILTER'].each { alias ->
                assert workflow.trace.tasks().count { task -> task.name.contains(":${alias} (") } == 2
            }
            assert workflow.out.reads_clean.size() == 2
            workflow.out.reads_clean.each { meta, reads ->
                def files = reads instanceof List ? reads : [reads]
                assert files.size() == (meta.single_end ? 1 : 2)
                assert files.every { read -> read.endsWith('_filtered.fastq.gz') }
            }
            assert workflow.out.bbduk_logs.size() == 4
            assert workflow.out.bbduk_stats.size() == 4
            assert workflow.out.bbduk_dropped.size() == 2
            assert workflow.out.trim_dropped.size() == 2
            workflow.out.bbduk_logs.each { meta, log ->
                def command = path(log).text.readLines().first()
                if (log.endsWith('.trimmed.bbduk.log')) {
                    assert command.contains('ktrim=r')
                    assert command.contains('ref=adapters.fa')
                    assert !command.contains('phix')
                    assert !command.contains('transcriptome.fasta')
                    assert command.contains('mink=11')
                } else {
                    assert log.endsWith('.filtered.bbduk.log')
                    assert command.contains('ktrim=f')
                    assert command.contains('ref=phix,transcriptome.fasta ')
                    assert !command.contains('adapters.fa')
                    ['mink=', 'tpe=', 'tbo=', 'minlen='].each { arg ->
                        assert !command.contains(arg)
                    }
                    // The filtering task consumes the first task's trimmed reads.
                    assert command.contains('_trimmed.fastq.gz')
                }
            }
            assert workflow.out.bbduk_stats.collect { meta, stats -> path(stats).fileName.toString() }.toSet() ==
                ['single.trimmed.stats.txt', 'single.filtered.stats.txt', 'paired.trimmed.stats.txt', 'paired.filtered.stats.txt'].toSet()
            workflow.out.bbduk_dropped.each { meta, reads ->
                assert (reads instanceof List ? reads : [reads]).every { read -> read.endsWith('.filtered.discarded.fastq.gz') }
            }
            workflow.out.trim_dropped.each { meta, reads ->
                assert (reads instanceof List ? reads : [reads]).every { read -> read.endsWith('.trimmed.discarded.fastq.gz') }
            }
        }
    }

    test("empty contaminant channel - single and paired stubs") {
        options "-stub"
        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                def read1 = file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                def read2 = file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                input[0] = Channel.of(
                    tuple([id: 'single', single_end: true, instrument_platform: 'ILLUMINA'], [read1]),
                    tuple([id: 'paired', single_end: false, instrument_platform: 'ILLUMINA'], [read1, read2])
                )
                input[1] = Channel.empty()
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().size() == 6
            assert workflow.out.reads_clean.size() == 2
            assert workflow.out.bbduk_logs.size() == 4
            assert workflow.out.bbduk_stats.size() == 4
            assert workflow.out.bbduk_dropped.size() == 2
            assert workflow.out.trim_dropped.size() == 2
            workflow.out.reads_clean.each { meta, reads ->
                def files = reads instanceof List ? reads : [reads]
                assert files.size() == (meta.single_end ? 1 : 2)
                assert files.every { read -> read.endsWith('_filtered.fastq.gz') }
            }
        }
    }
}
