process {

    withName: BBDUK_CUSTOM {
        ext.args = 'ktrim=r trimq=10 qtrim=r'
        ext.prefix = { "${meta.id}.trim" }
        memory = 4.GB
        cpus = 4
    }

    // Keep the standalone module's trimming prefix out of workflow aliases.
    withName: 'PREPROCESS_READS:BBDUK_.*' {
        ext.prefix = { "${meta.id}" }
    }

}
