nextflow_process {

    name "Test Process GATK4_MARKDUPLICATES_CUSTOM"
    script "../main.nf"
    process "GATK4_MARKDUPLICATES_CUSTOM"

    tag "modules"
    tag "modules_nfcore"
    tag "gatk4"
    tag "gatk4/markduplicates"

    test("sarscov2 - single bam") {
        config "./bam.config"
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = file("${projectDir}/modules/local/gatk4/markduplicates_custom/tests/core_test.bed", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.bam,
                    process.out.bai,
                    file(process.out.metrics[0][1]).name,
                    process.out.findAll { k, _ -> k.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("sarscov2 - bam with reference") {
        config "./bam.config"
        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                input[1] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true)
                input[2] = file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                input[3] = file("${projectDir}/modules/local/gatk4/markduplicates_custom/tests/core_test.bed", checkIfExists: true)
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.bam,
                    process.out.bai,
                    file(process.out.metrics[0][1]).name,
                    process.out.findAll { k, _ -> k.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("stub") {
        config "./bam.config"
        options "-stub"
        when {
            process {
                """
                input[0] = [[ id:'test', single_end:false ], []]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}
