nextflow_process {

    name "Test Process GUNZIP_REFFASTA"
    script "../main.nf"
    process "GUNZIP_REFFASTA"

    tag "modules"
    tag "modules_local"
    tag "gunzip_reffasta"

    test("sarscov2 - gzipped fasta") {

        when {
            process {
                """
                input[0] = file(
                    params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.gz',
                    checkIfExists: true
                )
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }
    }
}

